# Test-Umgebung. Kopieren nach .env.test und ausfüllen. NIE einchecken.
APP_ENV=test
# Neues Supabase-Projekt in Frankfurt (eu-central-1) – NICHT essogronliskkfhocxst!
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PROJECT_REF=<projekt-ref>
SUPABASE_REGION=eu-central-1
SUPABASE_ANON_KEY=
# Nur Server. Nie ins Frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Alle Mails gehen im Test ausschließlich hierhin.
MAIL_TEST_RECIPIENT=
KOSIT_VALIDATOR_URL=http://localhost:8081
# Signiert die Anmeldung der Mitarbeitenden am Handy (mind. 32 zufällige Zeichen, z. B. openssl rand -hex 32)
SESSION_SECRET=
# Öffentliche Adresse (für QR-Codes an den Objekten)
PUBLIC_URL=
