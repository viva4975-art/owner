{
  "appId": "de.vivadeluxe.app",
  "appName": "Viva-Deluxe",
  "webDir": "www",
  "server": {
    "url": "https://app.viva-deluxe-reinigung.de/app",
    "allowNavigation": ["app.viva-deluxe-reinigung.de"],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
