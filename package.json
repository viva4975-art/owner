{
  "name": "viva-deluxe-app",
  "version": "0.1.0",
  "description": "Viva-Deluxe Betriebs-App (Ablösung Fortytools)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "env:check:test": "tsx --env-file=.env.test src/config/check.ts",
    "env:check:live": "tsx --env-file=.env.live src/config/check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viva4975-art/owner.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/viva4975-art/owner/issues"
  },
  "homepage": "https://github.com/viva4975-art/owner#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
