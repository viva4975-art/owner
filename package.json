{
  "name": "viva-deluxe-app",
  "version": "0.1.0",
  "description": "Viva-Deluxe Betriebs-App (Ablösung Fortytools)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "dev": "tsx watch --env-file=.env.dev src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx --env-file=.env.dev src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.dev src/scripts/seed.ts --demo",
    "kosit": "./scripts/kosit.sh",
    "e2e": "node e2e/navigation.e2e.mjs",
    "e2e:module": "node e2e/modules.e2e.mjs",
    "e2e:zeit": "node e2e/zeit.e2e.mjs",
    "e2e:einkauf": "node e2e/einkauf.e2e.mjs",
    "e2e:rechte": "node e2e/rechte.e2e.mjs",
    "e2e:auftrag": "node e2e/auftrag.e2e.mjs",
    "e2e:objekt": "node e2e/objekt.e2e.mjs",
    "e2e:app": "node e2e/app.e2e.mjs",
    "e2e:leistungen": "node e2e/leistungen.e2e.mjs",
    "e2e:mahnung": "node e2e/mahnung.e2e.mjs",
    "e2e:personal": "node e2e/personal.e2e.mjs",
    "e2e:planung": "node e2e/planung.e2e.mjs",
    "e2e:auswertung": "node e2e/auswertung.e2e.mjs",
    "e2e:angebot": "node e2e/angebot.e2e.mjs",
    "e2e:transfer": "node e2e/transfer.e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viva4975-art/owner.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/viva4975-art/owner/issues"
  },
  "homepage": "https://github.com/viva4975-art/owner#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.12.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@e-invoice-eu/core": "^3.3.3",
    "@hono/node-server": "^2.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
